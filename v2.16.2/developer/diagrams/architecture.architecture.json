  "cards": [
    {
      "dot": "emerald",
      "title": "Engine + registries",
      "items": [
        "SupernotifyEngine builds a Context holding each registry, HomeAssistantAPI, DupeChecker, Snoozer and MediaStorage",
        "DeliveryRegistry keeps only viable transports and their deliveries",
        "PeopleRegistry builds Recipients from person entities and their Mobile App devices"
      ]
    },
    {
      "dot": "violet",
      "title": "Entities",
      "items": [
        "switch per scenario, recipient, transport and delivery",
        "binary_sensor per scenario; notify.recipient_<name> per recipient",
        "notifications + failures sensors; reset-overrides button"
      ]
    },
    {
      "dot": "cyan",
      "title": "Home Assistant integrations",
      "items": [
        "All Home Assistant access goes through HomeAssistantAPI: call_service, states, events, registries, conditions, storage",
        "Email calls the SMTP notify action; Alexa Devices calls notify.send_message",
        "Mobile Push calls notify.mobile_app_<device>"
      ]
    }
  ]
